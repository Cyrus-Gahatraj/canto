~~
    Module System Test

    `get "path"` with no block compiles another .ct file in place. The
    path is relative to the importing file and `.ct` is optional. A module
    is loaded once, however many times it is imported.
    `get "lib" { ... }` with a block declares C functions instead.
~~

get "lib/mathx"
get "lib/consts.ct"

get "m" {
    sqrt(x: double): double
}

write square(answer)
write sqrt(16.0)
