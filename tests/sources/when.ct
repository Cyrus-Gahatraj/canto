~~
    when.ct — Comprehensive test for the 'when' statement

    Tests all three arm forms:
      1. Integer equality:  1: { ... }          matches subject == 1
      2. Predicate:         . > 4: { ... }       matches subject satisfies condition
                            (dot '.' is the subject itself)
                            > 4: { ... }         the same, with the '.' left out
      3. String equality:   "hello": { ... }     uses strcmp under the hood

    Separators: semicolons between arms act as explicit breaks (no fall-through).
    Default arm: '_' catches anything that didn't match.
~~

~ -------------------------------------------------------------------
~ Test 1: Integer equality + _ default
~ -------------------------------------------------------------------
let code 2

when code {
    1: { write "one" }
    2: { write "two" };
    3: { write "three" }
    _: { write "other" }
}

~ -------------------------------------------------------------------
~ Test 2: Predicate arms — dot refers to the subject value
~ -------------------------------------------------------------------
let score 75

when score {
    . > 90: { write "A" };
    . > 75: { write "B" };
    . > 60: { write "C" };
    _:      { write "F" }
}

~ -------------------------------------------------------------------
~ Test 3: String equality
~ -------------------------------------------------------------------
let greeting "hello"

when greeting {
    "hi":    { write "casual" }
    "hello": { write "formal" };
    "hey":   { write "casual" }
    _:       { write "unknown" }
}

~ -------------------------------------------------------------------
~ Test 4: Bare comparison arms — '> 90' means '. > 90'
~ -------------------------------------------------------------------
let grade 82

when grade {
    >= 90: { write "A" }
    >80:   { write "B" }
    != 0:  { write "C" }
    _:     { write "F" }
}

~ Expected output (one line per test):
~ two
~ C
~ formal
~ B
