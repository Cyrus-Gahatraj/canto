let add(a, b) {
    return a + b
}

let multiply(a, b) {
    return a * b
}

let square(x) {
    return multiply(x, x)
}

~ Pythagorean theorem:
~ c² = a² + b²

let pythagorus(a, b) {
    let a2 square(a)
    let b2 square(b)

    return add(a2, b2)
}

let side_a 3
let side_b 4

let result pythagorus(side_a, side_b)

write result

