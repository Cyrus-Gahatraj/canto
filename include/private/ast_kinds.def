
/* Structural & Statements */
AST_NODE(PROGRAM,     "Program Root")
AST_NODE(LET,         "Variable/Function Binding")
AST_NODE(WRITE,       "Write statement")
AST_NODE(DESIGN,      "Design Declaration")
AST_NODE(FIELD,       "Design Field")
AST_NODE(PARAM,       "Function Parameter")
AST_NODE(RETURN,      "Return Statement")
AST_NODE(BLOCK,       "Block Expression/Statement")

/* Standard Expressions */
AST_NODE(BINARY,      "Binary Operation")
AST_NODE(UNARY,       "Unary Operation")
AST_NODE(CALL,        "Invocational Call")
AST_NODE(DOT,         "Current Context Access (.)")
AST_NODE(DOT_DOT,     "Parent Context Access (..)")
AST_NODE(INDEX,       "Index Access ([])")
AST_NODE(GROUP,       "Grouped Expression")

/* Structural Modification Expressions */
AST_NODE(EDIT,        "Structural Edit Block (.edit)")
AST_NODE(EDIT_PAIR,   "Edit Configuration Pair")
AST_NODE(RELATIVE,    "Relative Context Operation (. op)")

/* Control Flow Expressions */
AST_NODE(IF,             "Conditional Expression (if)")
AST_NODE(WHEN,           "Pattern Match Expression (when)")
AST_NODE(WHEN_ARM,		 "Pattern Match Arm")
AST_NODE(TRY_SCOPE,      "Try Scope Block")
AST_NODE(OPTIONAL_DECL,  "Optional Declaration")
AST_NODE(LOOP,			 "Loop statement")
AST_NODE(CONTINUE,		 "Continue Statement")
AST_NODE(BREAK,			 "Break Statement")
AST_NODE(TYPE,           "Type Descriptor")

/* Literal Leaves */
AST_NODE(IDENT,       "Identifier")
AST_NODE(INT_LIT,     "Integer Literal")
AST_NODE(DOUBLE_LIT,  "Floating Point Literal")
AST_NODE(STRING_LIT,  "String Literal")
AST_NODE(BOOL_LIT,    "Boolean Literal")

